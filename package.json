{
  "name": "angular-custom-libraries",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:libs && ng serve",
    "build:libs": "ng build dynamic-form && ng build dynamic-table && ng build dynamic-modal && ng build dynamic-alert && ng build dynamic-toast && ng build dynamic-data-table",
    "publish:libs": "cd dist/dynamic-form && npm publish --access public && cd ../dynamic-table && npm publish --access public && cd ../dynamic-modal && npm publish --access public && cd ../dynamic-alert && npm publish --access public && cd ../dynamic-toast && npm publish --access public && cd ../dynamic-data-table && npm publish --access public",
    "build": "npm run build:libs && ng build playground",
    "watch": "ng build dynamic-form --watch",
    "test": "ng test --no-watch",
    "test:watch": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/ssr": "^22.0.1",
    "@monaco-editor/loader": "^1.7.0",
    "@ngxmc/datetime-picker": "^20.1.0",
    "ang-jsoneditor": "^6.0.0",
    "bootstrap": "^5.3.8",
    "devlab-one-dynamic-alert": "^2.0.0",
    "devlab-one-dynamic-data-table": "^2.0.0",
    "devlab-one-dynamic-form": "^2.0.0",
    "devlab-one-dynamic-modal": "^2.0.0",
    "devlab-one-dynamic-table": "^2.0.0",
    "devlab-one-dynamic-toast": "^2.0.0",
    "jsoneditor": "^10.4.3",
    "ng-dynamic-component": "^10.8.2",
    "ngx-json-viewer": "^3.2.1",
    "ngx-mat-select-search": "^8.0.6",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^22.0.1",
    "@types/jsoneditor": "^9.9.6",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.8"
  }
}
